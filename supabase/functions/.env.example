# Supabase Edge Function secrets. The Next.js app does not read any of these.
# Names and placeholders only. Never commit a real value.
#   Hosted: supabase secrets set NAME=... (or Dashboard > Edge Functions > Secrets).
#   Local:  copy to supabase/functions/.env (git-ignored) for `supabase functions serve`.
# Supabase provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to every function;
# do not set them yourself.
# src/__tests__/env-example.test.ts fails when a function reads a name missing here.

# --- send-contact-email -------------------------------------------------------
# Resend API key. Required: the function sends the contact mail with it.
RESEND_API_KEY=
# Shared secret the on_new_contact_message trigger sends in x-contact-hook-secret.
# Required. Same value as the Vault secret contact_hook_secret.
CONTACT_HOOK_SECRET=
# Sender address. Optional (default in index.ts); the domain must be verified in Resend.
EMAIL_FROM=
# Recipient address. Optional (default in index.ts).
CONTACT_TO=

# --- testdata-eval ------------------------------------------------------------
# Shared secret the lab-mtg-scanner workflow sends in x-testdata-key. Required.
TESTDATA_EXPORT_KEY=
