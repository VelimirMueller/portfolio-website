# Environment variables the Next.js app and the repo scripts read.
# Names and placeholders only. Never commit a real value.
#   Local: copy to .env.local (git-ignored) and fill in.
#   Production: set the values in the Vercel project settings.
# NEXT_PUBLIC_* is inlined into the browser bundle at build time (public).
# Every other name stays on the server.
# Supabase Edge Function secrets are not here: see supabase/functions/.env.example.
# src/__tests__/env-example.test.ts fails when the code reads a name missing here.

# --- Site ---------------------------------------------------------------------
# Supabase project URL. Required. Public. Set in Vercel.
# Read by src/utils/supabase/*, /api/contact and /api/collect.
NEXT_PUBLIC_SUPABASE_URL=YOUR_URL
# Supabase publishable key. Required. Public. Set in Vercel.
# Read by src/utils/supabase/*, /api/contact and /api/collect.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=YOUR_KEY
# Canonical site origin. Optional (default https://www.velimir-mueller.de). Public.
# Set in Vercel for preview deployments only. Read by src/config/site.ts.
NEXT_PUBLIC_SITE_URL=

# --- Contact form -------------------------------------------------------------
# hCaptcha site key. Required for the contact form: without it (or with this placeholder)
# the form shows no captcha. Public. Set in Vercel.
# Read by src/app/[locale]/(main)/contact/ContactContent.tsx and /api/contact.
NEXT_PUBLIC_HCAPTCHA_SITEKEY=YOUR_HCAPTCHA_SITEKEY
# hCaptcha secret. Required for the contact form. Server-only. Set in Vercel.
# Read by src/app/api/contact/route.ts.
HCAPTCHA_SECRET=YOUR_HCAPTCHA_SECRET
# The contact mail is sent by the send-contact-email Edge Function, not by Next.js.
# Its RESEND_API_KEY is a Supabase function secret (supabase/functions/.env.example).

# --- Analytics ----------------------------------------------------------------
# Ingest secret for /api/collect. Optional: without it the route answers 204 and stores nothing.
# Server-only. Set in Vercel (Production). Setup: docs/REFERENCE.md, "Analytics".
ANALYTICS_INGEST_SECRET=

# --- Admin KPIs (Vercel tab) --------------------------------------------------
# Vercel REST API token. Optional: without it the tab shows how to set it up.
# Server-only. Set in Vercel. Read by src/app/admin/_lib/vercelStats.ts.
VERCEL_API_TOKEN=
# Vercel project name or ID. Optional (default portfolio-website). Server-only. Set in Vercel.
VERCEL_PROJECT=
# Vercel team ID. Optional (only for a team-owned project). Server-only. Set in Vercel.
VERCEL_TEAM_ID=

# --- Scripts (local only, never in Vercel) ------------------------------------
# Postgres session-pooler connection string from the Supabase dashboard (Connect).
# Used by psql with the Magic catalog loaders in scripts/mtg/. Not read by the app.
SUPABASE_DB_URL=
